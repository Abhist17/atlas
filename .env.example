# Copy to .env and fill in. .env is gitignored — never commit real creds.
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# paper | live
ATLAS_MODE=paper

# Email OTP login (optional). Without these, Atlas runs in "dev mode":
# the login code is printed to the server console and shown on the verify page.
# To actually email codes, fill these in (Gmail needs an App Password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=you@gmail.com

# --- Access control ------------------------------------------------------
# Where uvicorn binds. Atlas will NOT show login codes on screen unless this is
# loopback, because on a LAN or public bind the code is the only credential and
# showing it to whoever asks lets anyone sign in as anyone.
ATLAS_BIND_HOST=127.0.0.1
ATLAS_PORT=8000

# Comma-separated emails allowed to sign in. Leave empty to allow anyone
# (safe only on loopback, or when SMTP above actually delivers the code).
ATLAS_ALLOWED_EMAILS=

# --- Background sweep ----------------------------------------------------
# Journals ENTER signals across the universe on a timer, so the track record is
# a sample of the market rather than of whatever you happened to click.
ATLAS_SWEEP=1
ATLAS_SWEEP_MINUTES=5
ATLAS_SWEEP_LIMIT=25
