# Copy to .env and fill in. .env is gitignored — never commit real creds.
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# paper | live
ATLAS_MODE=paper

# Email OTP login (optional). Without these, Atlas runs in "dev mode":
# the login code is printed to the server console and shown on the verify page.
# To actually email codes, fill these in (Gmail needs an App Password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=you@gmail.com
